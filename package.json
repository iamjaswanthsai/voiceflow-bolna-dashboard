{
  "name": "voiceflow-dashboard",
  "version": "1.0.0",
  "description": "Enterprise Voice AI Lead Qualification Dashboard powered by Bolna",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "npx vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/db/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "vite": "^6.3.4"
  }
}
